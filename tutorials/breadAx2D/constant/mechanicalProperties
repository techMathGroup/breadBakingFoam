FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
(
    bread
    {
        type            viscoBread;
        rho             rho [ 1 -3 0 0 0 0 0 ] 300; // -- NOTE: not used (calculated in solids4foam)
        E               E [ 1 -1 -2 0 0 0 0 ] 12000;
        nu              nu [ 0 0 0 0 0 0 0 ] 0.49;
        mu0Raw          mu0Raw [ 1 -1 -2 0 0 0 0 ] 300;
        kappa0Raw       kappa0Raw [ 1 -1 -2 0 0 0 0 ] 1000;
        muV1Raw          muV1Raw [ 1 -1 -2 0 0 0 0 ] 3000;
        muV2Raw          muV2Raw [ 1 -1 -2 0 0 0 0 ] 3000;
        kappaVRaw      kappaVRaw [ 1 -1 -2 0 0 0 0 ] 6000;
        mu0Baked        mu0Baked [ 1 -1 -2 0 0 0 0 ] 12500;
        kappa0Baked     kappa0Baked [ 1 -1 -2 0 0 0 0 ] 40000;
        tau1 1;
        tau2 1;
        tGelat 65;
        alphaBiot 1;
    }
);

