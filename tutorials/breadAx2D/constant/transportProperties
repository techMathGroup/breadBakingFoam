FoamFile
{
    version     1.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// ************************************************************************* //
// -- general constants
genProps
{
    univR   univR   [1  2 -2 -1 -1 0 0]  8.31446261815324;
}

// ************************************************************************* //
withDeformation 1;

withEq 1;

gasPermeabilityRaw gasPermeabilityRaw [0 2 0 0 0 0 0] 9e-13;
gasPermeabilityBaked gasPermeabilityBaked [0 2 0 0 0 0 0] 1e-11;

tort 10;
tortOpen 10;
tortClosed 10;

alphaD0 0.39;
// alphaD0 0.91;

zhang 1;
delta 0.15;
moistureMin 0.33;


omegaVInfTableDict   
{
    file "$FOAM_CASE/constant/omegaVInfTable";
    outOfBounds warn;
}
