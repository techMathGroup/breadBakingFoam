internalField   uniform 782;


boundaryField
{
	"(sides|bottom|bottom2|top)"
	{
        type zeroGradient;
        // type fixedValue;
        // value $internalField;
	}

	"(wedgeZ0|wedgeZE)"
	{
		type wedge;
	}
  "symmetryPatch"
  {
    type  symmetry;
  }
}

