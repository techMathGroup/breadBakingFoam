FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omegaV;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.015e-3;

boundaryField
{
    "symmetryPatch"
    {
        type  symmetry;
    }

    sides
    {
        type zeroGradient;
        // type fixedValue;
        // value $internalField;
    }
    "(wedgeZ0|wedgeZE)"
	{
		type wedge;
	}

    bottom
    {

        type zeroGradient;

    }
    bottom2
    {
        type zeroGradient;
        // type fixedValue;
        // value $internalField;
        // type zeroGradient;
    }
}


