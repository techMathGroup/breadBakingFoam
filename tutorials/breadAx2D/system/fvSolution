FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(pG|T|omegaV|omegaC|alphaS|alphaL|alphaLGel|alphaCrust|rhoG|D|omegaAir2|pGTest|dP)"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.01;
    }
 
    "(pG|T|omegaV|omegaC|alphaS|alphaL|alphaLGel|alphaCrust|rhoG|D|omegaAir2|pGTest|dP)Final"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-12;
    }

    // D
