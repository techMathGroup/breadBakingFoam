}

PIMPLE
{
    nOuterCorrectors 250;
    debug 2;    // -- debug level
    residualControl
    {
        omegaV        
        {
            tolerance 1e-9;
            relTol 0;
        }
        T           
        {
            tolerance 1e-9;
            relTol 0;
        }
        pG         
        {
            tolerance 1e-9;
            relTol 0;
        }
    }
}

relaxationFactors
{
    fields
    {
        D 0.1;
        // // DFinal 0.1;
        omegaV 0.1;
        omegaC 0.1;
        // T 0.9;
        pG 0.1;
        // rhoG 0.1;
    }
    equations
    {
        // gammaSnGradCorr(pG)_0 0.5;
