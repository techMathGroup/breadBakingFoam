FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(moisture|XCO2InL)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.01;
    }

    "(moisture|XCO2InL)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
    }

    "(pG|omegaV|omegaC|T|D)"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0.01;
    }

    "(pG|omegaV|omegaC|T|D)Final"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-12;
    }


}

PIMPLE
{
    nOuterCorrectors 250;
    debug 2;    // -- debug level
    nItersAfter 1;
    residualControl
    {
        omegaV        
        {
            tolerance 1e-9;
            relTol 0;
        }
        T           
        {
            tolerance 1e-9;
            relTol 0;
        }
        pG         
        {
            tolerance 1e-9;
            relTol 0;
        }
    }
}

relaxationFactors
{
    fields
    {
        D 0.1;
        // // DFinal 0.1;
        omegaV 0.2;
        omegaC 0.2;
        // // // // omegaAir 0.1;
        T 0.2;
        pG 0.2;
        // rhoG 0.1;
    }
    equations
    {
        // gammaSnGradCorr(pG)_0 0.5;
        // gammaSnGradCorr(omegaV)_0 0.5;
        // gammaSnGradCorr(T)_0 0.5;
        // snGradCorr(D) 0.5;
        // omegaV 0.999;
        // omegaC 0.999;
        // D 0.9999;
        // T 0.9999;
        // DFinal 0.1;
        // pG 0.999;
        // DFinal 0.95;
    }
}
