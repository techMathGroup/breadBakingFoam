FoamFile
{
    version     1.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;
// internalField   uniform 64794;
// internalField   uniform 162668.280336008;

boundaryField
{
    "symmetryPatch"
    {
        type  symmetry;
    }
    
    sides
    {
        type fixedValue;
        value $internalField;
    }
    "(wedgeZ0|wedgeZE)"
	{
		type wedge;
	}
    bottom
    {
        type fixedValue;
        value $internalField;
    }
}

